---
import Layout from "@/layouts/Layout.astro"
import { getBlogs } from "@blogs"
import { formatDate } from "@/utils/formatDate"
import MarkdownIt from 'markdown-it'
import { createHighlighter } from 'shiki'
import { createJavaScriptRegexEngine } from '@shikijs/engine-javascript'
import Comments from "@/components/sections/Comments.astro"
import Tag from "@/components/Tag.astro"
import { basics } from "@cv"
import { generateTOC, addHeadingIds } from "@/utils/generateTOC"

export async function getStaticPaths() {
  const blogs = getBlogs()
  return blogs.map((blog, index) => {
    const prevPost = index < blogs.length - 1 ? blogs[index + 1] : null
    const nextPost = index > 0 ? blogs[index - 1] : null

    return {
      params: { id: blog.id },
      props: { blog, prevPost, nextPost },
    }
  })
}

const { blog, prevPost, nextPost } = Astro.props
const { title, date, author, content, tags, readingTime, excerpt } = blog
const formattedDate = formatDate(date)

// Generate table of contents
const toc = generateTOC(content)
const showTOC = toc.length >= 3 // Only show TOC if there are 3+ headings

// SEO props
const siteUrl = basics.url
const canonicalUrl = `${siteUrl}/blog/${blog.id}`
const pageTitle = `${title} - Blog | Md Afridi Sk`

// JSON-LD structured data for BlogPosting with BreadcrumbList
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": siteUrl
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Blog",
          "item": `${siteUrl}/blog`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": title,
          "item": canonicalUrl
        }
      ]
    },
    {
      "@type": "BlogPosting",
      "@id": canonicalUrl,
      "headline": title,
      "description": excerpt,
      "image": `${siteUrl}/profile-pic.png`,
      "author": {
        "@type": "Person",
        "@id": `${siteUrl}/#person`,
        "name": author,
        "url": siteUrl
      },
      "datePublished": date,
      "dateModified": date,
      "publisher": {
        "@type": "Person",
        "@id": `${siteUrl}/#person`,
        "name": "Md Afridi Sk",
        "url": siteUrl
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonicalUrl
      },
      "url": canonicalUrl,
      "keywords": tags?.join(", ") || "",
      "wordCount": content.split(/\s+/).length,
      "articleSection": tags?.[0] || "Technology",
      "inLanguage": "en-US"
    }
  ]
}

// Blog-specific keywords
const blogKeywords = `${tags?.join(", ") || ""}, Md Afridi Sk, ${author}, tech blog, software engineering, ${title}`

const highlighter = await createHighlighter({
  themes: ['github-dark', 'solarized-light'],
  langs: ['javascript', 'typescript', 'css', 'html', 'bash', 'json', 'python', 'markdown'],
  engine: createJavaScriptRegexEngine()
})

const md = new MarkdownIt({
  html: true,
  linkify: true,
  typographer: true,
  highlight: (code, lang) => {
    const darkHtml = highlighter.codeToHtml(code, {
      lang: lang || 'text',
      theme: 'github-dark'
    })
    const lightHtml = highlighter.codeToHtml(code, {
      lang: lang || 'text',
      theme: 'solarized-light'
    })
    
    // Return both themes without outer wrapper - markdown-it won't add pre wrapper
    return `<div class="code-block-dark">${darkHtml}</div><div class="code-block-light">${lightHtml}</div>`
  }
})

// Custom renderer to prevent markdown-it from wrapping highlighted code in <pre>
md.renderer.rules.fence = (tokens, idx) => {
  const token = tokens[idx]
  const code = token.content
  const lang = token.info || 'text'

  // Handle Mermaid diagrams
  if (lang === 'mermaid') {
    return `<div class="mermaid-wrapper"><pre class="mermaid">${code}</pre></div>`
  }

  const darkHtml = highlighter.codeToHtml(code, {
    lang: lang,
    theme: 'github-dark'
  })
  const lightHtml = highlighter.codeToHtml(code, {
    lang: lang,
    theme: 'solarized-light'
  })

  return `<div class="code-block-wrapper"><button class="copy-button" aria-label="Copy code"><svg class="copy-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg><svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></button><div class="code-block-dark">${darkHtml}</div><div class="code-block-light">${lightHtml}</div></div>`
}

// Give external links a leading favicon and open them in a new tab.
const defaultLinkOpen =
  md.renderer.rules.link_open ||
  ((tokens, idx, options, _env, self) => self.renderToken(tokens, idx, options))

md.renderer.rules.link_open = (tokens, idx, options, env, self) => {
  const token = tokens[idx]
  const href = token.attrGet('href') || ''
  let icon = ''

  if (/^https?:\/\//i.test(href)) {
    token.attrSet('target', '_blank')
    token.attrSet('rel', 'noopener noreferrer')
    try {
      const host = new URL(href).hostname.replace(/^www\./, '')
      icon = `<img class="link-favicon" src="https://www.google.com/s2/favicons?domain=${host}&sz=64" alt="" width="16" height="16" loading="lazy" decoding="async" referrerpolicy="no-referrer" />`
    } catch {
      /* malformed URL — no icon */
    }
  } else if (href.startsWith('mailto:')) {
    icon = `<svg class="link-favicon link-favicon--mail" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="1.5" y="3" width="13" height="10" rx="2" stroke="currentColor" stroke-width="1.2"/><path d="m2.5 4.5 5.5 4 5.5-4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>`
  }

  return defaultLinkOpen(tokens, idx, options, env, self) + icon
}

let renderedContent = md.render(content)
renderedContent = addHeadingIds(renderedContent)
---

<Layout
  title={pageTitle}
  description={excerpt}
  canonicalUrl={canonicalUrl}
  ogType="article"
  keywords={blogKeywords}
  jsonLd={jsonLd}
>
  <div class="read-progress" aria-hidden="true">
    <div class="read-progress__fill" id="read-progress-fill"></div>
  </div>

  <main class="post-shell">
    {showTOC && (
      <aside class="toc-rail" aria-label="Table of contents">
        <nav class="toc-linenav" id="toc-linenav">
          {toc.map((item) => (
            <a class="toc-linenav__item" href={`#${item.id}`} data-toc-id={item.id} title={item.text}>
              <span class="toc-linenav__tick" aria-hidden="true"></span>
              <span class="toc-linenav__label">{item.text}</span>
            </a>
          ))}
        </nav>
      </aside>
    )}

    <div class="post-topbar">
      <a href="/blog" class="glass-btn" aria-label="Back to writing">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M8 5 3.5 9.5 8 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M3.5 9.5H12a4.5 4.5 0 0 1 0 9h-1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </a>
      <button id="copy-link" class="glass-btn" type="button" aria-label="Copy link to this post">
        <svg class="glass-btn__link" width="17" height="17" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M8.7 11.3a3.2 3.2 0 0 0 4.5 0l2.1-2.1a3.2 3.2 0 1 0-4.5-4.5l-1.1 1.1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
          <path d="M11.3 8.7a3.2 3.2 0 0 0-4.5 0l-2.1 2.1a3.2 3.2 0 1 0 4.5 4.5l1.1-1.1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        </svg>
        <svg class="glass-btn__check" width="17" height="17" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="m5 10.5 3.2 3.2L15 6.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>

    <article class="post page-enter">
      <header class="post-head">
        <p class="mono-label post-head__meta">
          <time datetime={date}>{formattedDate}</time>
          <span class="post-head__dot" aria-hidden="true">·</span>
          <span>{readingTime}</span>
          <span class="post-head__dot" aria-hidden="true">·</span>
          <span>{author}</span>
        </p>
        <h1 class="post-head__title">{title}</h1>
        {excerpt && <p class="post-head__lede">{excerpt}</p>}
        {tags && tags.length > 0 && (
          <div class="post-head__tags">
            {tags.map((tag: string) => <Tag tag={tag} />)}
          </div>
        )}
      </header>

      <div class="content">
        <div set:html={renderedContent} />
      </div>

      {(prevPost || nextPost) && (
        <footer class="post-foot">
          <nav class="foot-nav" aria-label="Post navigation">
            {prevPost ? (
              <a href={`/blog/${prevPost.id}`} class="foot-nav__link foot-nav__prev" rel="prev">
                <span class="foot-nav__dir"><span aria-hidden="true">←</span> Previous</span>
                <span class="foot-nav__title">{prevPost.title}</span>
              </a>
            ) : (
              <span></span>
            )}
            {nextPost ? (
              <a href={`/blog/${nextPost.id}`} class="foot-nav__link foot-nav__next" rel="next">
                <span class="foot-nav__dir">Next <span aria-hidden="true">→</span></span>
                <span class="foot-nav__title">{nextPost.title}</span>
              </a>
            ) : (
              <span></span>
            )}
          </nav>
        </footer>
      )}
    </article>

    <Comments />

    <!-- Lightbox Modal -->
    <div id="lightbox" hidden aria-hidden="true">
      <div class="lightbox-backdrop"></div>
      <button class="lightbox-close" aria-label="Close lightbox">×</button>
      <div class="lightbox-viewport">
        <div id="lightbox-container"></div>
      </div>
      <div class="lightbox-controls">
        <button id="zoom-in" aria-label="Zoom in">+</button>
        <button id="zoom-reset" aria-label="Reset zoom">Reset</button>
        <button id="zoom-out" aria-label="Zoom out">−</button>
      </div>
    </div>
  </main>
</Layout>

<style>
  /* ── Reading-progress bar ─────────────────────────────────────── */
  .read-progress {
    position: fixed;
    inset-inline: 0;
    inset-block-start: 0;
    z-index: 60;
    height: 2px;
    background: var(--color-rule);
    pointer-events: none;
  }

  .read-progress__fill {
    height: 100%;
    width: 0;
    background: var(--color-accent);
  }

  /* ── Reading column ───────────────────────────────────────────── */
  .post-shell {
    position: relative;
    width: 100%;
    max-width: 42.5rem;
    margin-inline: auto;
    padding: clamp(2.5rem, 6vw, 4.5rem) var(--gutter);
    box-sizing: border-box;
  }

  /* ── Top bar: back + copy-link glass buttons ──────────────────── */
  .post-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-block-end: var(--space-lg);
  }

  .glass-btn {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-pill);
    background: var(--color-paper-2);
    color: var(--color-ink-3);
    cursor: pointer;
    transition:
      color var(--dur-short) var(--ease-out),
      border-color var(--dur-short) var(--ease-out),
      background-color var(--dur-short) var(--ease-out);
  }

  .glass-btn:hover {
    color: var(--color-ink);
    border-color: var(--color-rule-2);
    background: var(--color-paper-3);
  }

  .glass-btn:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .glass-btn__check {
    display: none;
    color: var(--color-accent-text);
  }

  .glass-btn.is-copied .glass-btn__link {
    display: none;
  }

  .glass-btn.is-copied .glass-btn__check {
    display: block;
  }

  /* ── Line-nav TOC (sticky left rail, wide screens only) ───────── */
  .toc-rail {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 100%;
    width: 240px;
    height: 100%;
    padding-inline-end: 2.75rem;
    display: none;
  }

  .toc-linenav {
    position: sticky;
    inset-block-start: 6rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    max-height: calc(100vh - 8rem);
    overflow-y: auto;
    scrollbar-width: none;
  }

  .toc-linenav::-webkit-scrollbar {
    display: none;
  }

  .toc-linenav__item {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    min-width: 0;
  }

  .toc-linenav__tick {
    display: block;
    height: 1px;
    width: 24px;
    flex-shrink: 0;
    background: var(--color-ink-faint);
    transition:
      width var(--dur-short) var(--ease-out),
      background-color var(--dur-short) var(--ease-out);
  }

  .toc-linenav__label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: var(--text-sm);
    color: var(--color-ink-3);
    transition: color var(--dur-short) var(--ease-out);
  }

  .toc-linenav__item:hover .toc-linenav__tick,
  .toc-linenav__item[aria-current="true"] .toc-linenav__tick {
    width: 40px;
    background: var(--color-accent);
  }

  .toc-linenav__item:hover .toc-linenav__label,
  .toc-linenav__item[aria-current="true"] .toc-linenav__label {
    color: var(--color-ink);
  }

  .toc-linenav__item:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  /* ── Post header ──────────────────────────────────────────────── */
  .post-head {
    margin-block-end: var(--space-xl);
  }

  .post-head__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3xs) var(--space-2xs);
  }

  .post-head__dot {
    color: var(--color-ink-4);
  }

  .post-head__title {
    margin-block-start: var(--space-sm);
    font-size: var(--text-display-s);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: var(--track-display);
    color: var(--color-ink);
  }

  .post-head__lede {
    margin-block-start: var(--space-sm);
    max-width: var(--measure);
    font-size: var(--text-md);
    line-height: var(--leading-body);
    color: var(--color-ink-3);
  }

  .post-head__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin-block-start: var(--space-md);
  }

  .content {
    font-size: var(--text-md);
    line-height: 1.72;
    color: var(--color-ink-3);
    overflow-wrap: break-word;
    word-wrap: break-word;
    overflow-x: hidden;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .content > div {
    width: 100%;
    display: block;
    max-width: 100%;
    box-sizing: border-box;
    overflow: visible;
  }

  /* Injected markdown must be styled via :global — Astro's scope attribute
     never lands on set:html content. */
  .content :global(p) {
    margin-block: var(--space-md);
    color: var(--color-ink-3);
    text-wrap: pretty;
  }

  .content :global(h1),
  .content :global(h2),
  .content :global(h3),
  .content :global(h4) {
    font-family: var(--font-display);
    color: var(--color-ink);
    letter-spacing: var(--track-display);
    line-height: 1.2;
    scroll-margin-top: 6rem;
  }

  .content :global(h1) {
    font-size: 1.6rem;
    font-weight: 600;
    margin: 3rem 0 1rem;
  }

  .content :global(h2) {
    font-size: 1.3rem;
    font-weight: 600;
    margin: 3rem 0 0.75rem;
  }

  .content :global(h3) {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 2.25rem 0 0.5rem;
  }

  .content :global(h4) {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 1.75rem 0 0.5rem;
  }

  .content :global(ul),
  .content :global(ol) {
    margin-block: var(--space-md);
    padding-inline-start: 1.4em;
    color: var(--color-ink-3);
  }

  .content :global(ul) {
    list-style: disc;
  }

  .content :global(ol) {
    list-style: decimal;
  }

  .content :global(li) {
    margin-block: 0.4em;
    padding-inline-start: 0.25em;
  }

  .content :global(li)::marker {
    color: var(--color-ink-4);
  }

  .content :global(a) {
    color: var(--color-accent-text);
    text-decoration: underline;
    text-decoration-color: var(--color-accent-mid);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--dur-short) var(--ease-out);
  }

  .content :global(a:hover) {
    text-decoration-color: var(--color-accent);
  }

  /* !important needed to beat the general `.content img` block/centered rule. */
  .content :global(.link-favicon) {
    display: inline-block !important;
    width: 1.1em !important;
    height: 1.1em !important;
    margin: 0 0.25em 0 0 !important;
    vertical-align: -0.2em !important;
    border: 0 !important;
    border-radius: 3px !important;
  }

  .content :global(.link-favicon--mail) {
    color: var(--color-ink-3);
  }

  .content :global(strong) {
    font-weight: 600;
    color: var(--color-ink);
  }

  /* The blog's signature: emphasis renders as Georgia italic. */
  .content :global(em) {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.05em;
    color: var(--color-ink-2);
  }

  .content :global(hr) {
    margin-block: var(--space-xl);
    border: 0;
    border-block-start: var(--rule-hair) solid var(--color-rule);
  }

  .content :global(img) {
    max-width: 100% !important;
    height: auto !important;
    display: block !important;
    margin: var(--space-lg) auto !important;
    border-radius: var(--radius-card) !important;
    object-fit: contain !important;
    border: 1px solid var(--color-rule) !important;
    box-shadow: none !important;
    transition: transform var(--dur-med) var(--ease-out) !important;
  }

  .content :global(img:hover) {
    transform: scale(1.01) !important;
  }

  .content pre {
    background-color: transparent;
    backdrop-filter: none;
    padding: 0;
    border-radius: 0;
    border: none;
    overflow: visible;
    margin: 5px 0 !important;
    box-shadow: none;
    line-height: 0;
    font-size: 0;
    display: block;
  }

  .content :global(pre.shiki) {
    padding: 1.25rem 1.5rem !important;
    border-radius: var(--radius-card) !important;
    margin: 0 !important;
    box-shadow: none !important;
    line-height: 1.6 !important;
    font-size: var(--text-sm) !important;
    display: block !important;
  }

  /* Don't override shiki's inline background-color styles */
  .content :global(.code-block-dark pre.shiki),
  .content :global(.code-block-light pre.shiki) {
    border: var(--rule-hair) solid var(--color-rule);
  }

  .content :global(pre) {
    margin: 0 !important;
    padding: 0 !important;
  }

  /* Theme switching for code blocks */
  .content :global(.code-block-wrapper) {
    position: relative;
    margin-block: var(--space-lg);
    contain: layout style; /* Performance optimization for hidden theme blocks */
  }

  .content :global(.copy-button) {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    padding: 0.5rem;
    min-width: 44px;
    min-height: 44px;
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    color: var(--text-color);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s ease, background-color 0.2s ease;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Show copy button on touch devices */
  @media (hover: none) and (pointer: coarse) {
    .content :global(.copy-button) {
      opacity: 0.7;
    }
  }

  .content :global(.copy-button .check-icon) {
    display: none;
  }

  .content :global(.copy-button.copied .copy-icon) {
    display: none;
  }

  .content :global(.copy-button.copied .check-icon) {
    display: block;
  }

  .content :global(.code-block-wrapper:hover .copy-button),
  .content :global(.code-block-wrapper:focus-within .copy-button) {
    opacity: 1;
  }

  .content :global(.copy-button:hover) {
    background-color: rgba(255, 255, 255, 0.2);
  }

  .content :global(.copy-button:active) {
    background-color: rgba(1, 155, 89, 0.3);
  }

  .content :global(.copy-button.copied) {
    background-color: rgba(1, 155, 89, 0.3);
    border-color: rgba(1, 155, 89, 0.5);
  }

  .content :global(.code-block-light),
  .content :global(.code-block-dark) {
    margin: 0;
  }

  /* Hide inactive theme and remove from render tree */
  .content :global(.code-block-light) {
    display: none;
    content-visibility: hidden; /* Modern browsers: skip rendering hidden content */
  }

  .content :global(.code-block-dark) {
    display: block;
    content-visibility: auto;
  }

  :global(.light) .content :global(.code-block-light) {
    display: block;
    content-visibility: auto;
  }

  :global(.light) .content :global(.code-block-dark) {
    display: none;
    content-visibility: hidden;
  }

  .content :global(:not(pre) > code) {
    background-color: var(--color-accent-dim);
    padding: 0.15em 0.4em;
    border-radius: var(--radius-sm);
    font-size: 0.85em;
    color: var(--color-accent-text);
    border: var(--rule-hair) solid var(--color-accent-mid);
  }

  .content :global(pre code) {
    background-color: transparent !important;
    padding: 0 !important;
    text-shadow: none !important;
    border: none !important;
  }

  .content :global(table) {
    width: 100%;
    margin-block: var(--space-lg);
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .content :global(th),
  .content :global(td) {
    border: var(--rule-hair) solid var(--color-rule);
    padding: 0.6rem 0.9rem;
    text-align: left;
    vertical-align: top;
  }

  .content :global(th) {
    font-size: var(--text-xs);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-3);
    background: var(--color-paper-2);
  }

  /* Editorial pull-quote: hairline rule + Georgia italic. */
  .content :global(blockquote) {
    margin-block: var(--space-lg);
    padding-inline-start: var(--space-md);
    border-inline-start: var(--rule-thick) solid var(--color-rule-2);
  }

  .content :global(blockquote p) {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.1rem;
    line-height: var(--leading-body);
    color: var(--color-ink-2);
  }

  /* Mermaid diagram styles */
  .content :global(.mermaid-wrapper) {
    margin: 2rem 0;
    padding: 2rem;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    overflow-x: auto;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .content :global(.mermaid-wrapper pre.mermaid) {
    background: transparent;
    margin: 0;
    padding: 0;
    border: none;
    text-align: center;
    line-height: 1.5;
    font-size: 14px;
  }

  .post-foot {
    margin-block-start: var(--space-2xl);
    padding-block-start: var(--space-lg);
    border-block-start: var(--rule-hair) solid var(--color-rule);
  }

  .foot-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }

  .foot-nav__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .foot-nav__prev {
    text-align: left;
  }

  .foot-nav__next {
    text-align: right;
    align-items: flex-end;
  }

  .foot-nav__dir {
    font-size: var(--text-xs);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--color-ink-4);
  }

  .foot-nav__title {
    font-size: var(--text-base);
    line-height: var(--leading-snug);
    color: var(--color-ink-3);
    transition: color var(--dur-short) var(--ease-out);
  }

  .foot-nav__link:hover .foot-nav__title {
    color: var(--color-ink);
  }

  .foot-nav__link:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  /* Show the line-nav rail only when the margin can hold it. */
  @media (width >= 80rem) {
    .toc-rail {
      display: block;
    }
  }

  @media (width <= 700px) {
    .foot-nav {
      grid-template-columns: 1fr;
    }

    .foot-nav__next {
      text-align: left;
      align-items: flex-start;
    }

    .content :global(pre),
    .content :global(pre.shiki) {
      padding: 1rem 1.5rem !important;
    }

    /* Always show copy button on mobile for better discoverability */
    .content :global(.copy-button) {
      opacity: 0.8;
    }
  }

  /* Mobile landscape optimizations */
  @media (max-height: 500px) and (orientation: landscape) {
    .post-shell {
      padding-block: 1.5rem;
    }

    .content {
      font-size: var(--text-base);
    }
  }

  /* Lightbox Styles */
  #lightbox {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  #lightbox:not([hidden]) {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .lightbox-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    width: 48px;
    height: 48px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    font-size: 2rem;
    line-height: 1;
    border-radius: 50%;
    cursor: pointer;
    z-index: 100002;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .lightbox-close:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.6);
    transform: scale(1.1);
  }

  .lightbox-close:active {
    transform: scale(0.95);
  }

  .lightbox-viewport {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    cursor: default;
    z-index: 100001;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-viewport.zoomed {
    cursor: grab;
  }

  .lightbox-viewport.dragging {
    cursor: grabbing;
  }

  #lightbox-container {
    position: relative;
    transform-origin: center center;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #lightbox-container img,
  #lightbox-container svg {
    max-width: 90vw;
    max-height: 90vh;
    width: auto;
    height: auto;
    display: block;
    background: var(--card-bg);
    border-radius: 8px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }

  #lightbox-container svg {
    padding: 2rem;
  }

  .lightbox-controls {
    position: absolute;
    bottom: 2rem;
    right: 2rem;
    display: flex;
    gap: 0.5rem;
    z-index: 100002;
  }

  .lightbox-controls button {
    width: 44px;
    height: 44px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    font-size: 1.25rem;
    font-weight: bold;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .lightbox-controls button:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.6);
    transform: scale(1.1);
  }

  .lightbox-controls button:active {
    transform: scale(0.95);
  }

  #zoom-reset {
    font-size: 0.75rem;
    width: auto;
    padding: 0 0.75rem;
  }

  /* Cursor hints for clickable images/diagrams */
  .content :global(img),
  .content :global(.mermaid-wrapper) {
    cursor: zoom-in;
  }

  /* Mobile responsive adjustments */
  @media (width <= 700px) {
    .lightbox-close {
      top: 1rem;
      right: 1rem;
      width: 44px;
      height: 44px;
      font-size: 1.75rem;
    }

    .lightbox-controls {
      bottom: 1rem;
      right: 1rem;
      flex-direction: column;
    }

    #lightbox-container img,
    #lightbox-container svg {
      max-width: 95vw;
      max-height: 85vh;
    }

    #lightbox-container svg {
      padding: 1rem;
    }
  }

  /* Prevent body scroll when lightbox is open */
  body.lightbox-open {
    overflow: hidden;
  }
</style>

<script>
  // Reading-progress bar tracks scroll depth.
  const progressFill = document.getElementById("read-progress-fill")
  if (progressFill) {
    let raf = 0
    const compute = () => {
      const doc = document.documentElement
      const max = doc.scrollHeight - doc.clientHeight
      const pct = max <= 0 ? 0 : Math.min(100, Math.max(0, (doc.scrollTop / max) * 100))
      progressFill.style.width = `${pct}%`
    }
    const onScroll = () => {
      cancelAnimationFrame(raf)
      raf = requestAnimationFrame(compute)
    }
    compute()
    window.addEventListener("scroll", onScroll, { passive: true })
    window.addEventListener("resize", onScroll)
  }

  // Copy-link button in the post top bar.
  const copyBtn = document.getElementById("copy-link")
  if (copyBtn) {
    copyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(window.location.href)
        copyBtn.classList.add("is-copied")
        setTimeout(() => copyBtn.classList.remove("is-copied"), 1500)
      } catch {
        /* clipboard unavailable — no-op */
      }
    })
  }

  // Line-nav TOC: highlight the last heading scrolled past a line near the top.
  const tocNav = document.getElementById("toc-linenav")
  if (tocNav) {
    const links = Array.from(tocNav.querySelectorAll<HTMLAnchorElement>("[data-toc-id]"))
    const headings = links
      .map((link) => document.getElementById(link.dataset.tocId ?? ""))
      .filter((el): el is HTMLElement => Boolean(el))

    if (headings.length) {
      const TOP = 140
      let rafId = 0
      const update = () => {
        let currentId = headings[0].id
        for (const heading of headings) {
          if (heading.getBoundingClientRect().top <= TOP) currentId = heading.id
        }
        const atBottom =
          window.innerHeight + window.scrollY >=
          document.documentElement.scrollHeight - 2
        if (atBottom) currentId = headings[headings.length - 1].id

        for (const link of links) {
          if (link.dataset.tocId === currentId) {
            link.setAttribute("aria-current", "true")
          } else {
            link.removeAttribute("aria-current")
          }
        }
      }
      const onScroll = () => {
        cancelAnimationFrame(rafId)
        rafId = requestAnimationFrame(update)
      }
      update()
      window.addEventListener("scroll", onScroll, { passive: true })
      window.addEventListener("resize", onScroll, { passive: true })
    }
  }
</script>

<script>
  import mermaid from 'mermaid';

  // Initialize Mermaid with theme based on current color scheme
  const initializeMermaid = () => {
    const isDark = !document.documentElement.classList.contains('light');
    mermaid.initialize({
      startOnLoad: true,
      theme: isDark ? 'dark' : 'default',
      themeVariables: {
        primaryColor: isDark ? '#019b59' : '#059669',
        primaryTextColor: isDark ? '#fff' : '#0f172a',
        primaryBorderColor: isDark ? '#019b59' : '#059669',
        lineColor: isDark ? '#4ade80' : '#10b981',
        secondaryColor: isDark ? '#1e293b' : '#f1f5f9',
        tertiaryColor: isDark ? '#334155' : '#e2e8f0',
        // Mermaid takes literal colours, not CSS variables. These mirror the
        // Phosphor paper tokens so diagrams sit on the page instead of on a
        // white rectangle. Keep in sync with tokens.css.
        background: isDark ? '#0e0e0e' : '#e4ddca',
        mainBkg: isDark ? '#181818' : '#ded6c1',
        textColor: isDark ? '#e2e8f0' : '#1e293b',
        fontSize: '16px'
      }
    });
  };

  // Initialize on page load
  initializeMermaid();

  // Re-initialize when theme changes
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (mutation.attributeName === 'class') {
        initializeMermaid();
        mermaid.run();
      }
    });
  });

  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['class']
  });

  // Copy button functionality
  const copyButtons = document.querySelectorAll('.copy-button');

  copyButtons.forEach(button => {
    button.addEventListener('click', async () => {
      const wrapper = button.parentElement;
      if (!wrapper) return;

      const codeBlock = wrapper.querySelector('pre code');

      if (codeBlock) {
        const code = codeBlock.textContent || '';

        try {
          await navigator.clipboard.writeText(code);
          button.classList.add('copied');

          setTimeout(() => {
            button.classList.remove('copied');
          }, 2000);
        } catch (err) {
          console.error('Failed to copy code:', err);
        }
      }
    });
  });

  // Lightbox functionality
  const lightboxState = {
    isOpen: false,
    currentScale: 1,
    minScale: 0.5,
    maxScale: 5,
    scaleStep: 0.3,
    translateX: 0,
    translateY: 0,
    isDragging: false,
    startX: 0,
    startY: 0,
    lastTouchDistance: 0,
    contentType: 'image'
  };

  const lightbox = document.getElementById('lightbox');
  const lightboxContainer = document.getElementById('lightbox-container');
  const lightboxViewport = document.querySelector('.lightbox-viewport');
  const closeBtn = document.querySelector('.lightbox-close');
  const backdrop = document.querySelector('.lightbox-backdrop');
  const zoomInBtn = document.getElementById('zoom-in');
  const zoomOutBtn = document.getElementById('zoom-out');
  const zoomResetBtn = document.getElementById('zoom-reset');

  function applyTransform() {
    if (lightboxContainer) {
      lightboxContainer.style.transform = `translate(${lightboxState.translateX}px, ${lightboxState.translateY}px) scale(${lightboxState.currentScale})`;
    }
  }

  function resetLightboxState() {
    lightboxState.currentScale = 1;
    lightboxState.translateX = 0;
    lightboxState.translateY = 0;
    lightboxState.isDragging = false;
    applyTransform();
    if (lightboxViewport) {
      lightboxViewport.classList.remove('zoomed', 'dragging');
    }
  }

  function openLightbox(element: HTMLElement) {
    if (!lightbox || !lightboxContainer) return;

    // Clear previous content
    lightboxContainer.innerHTML = '';

    // Clone and add content
    if (element.tagName === 'IMG') {
      const img = document.createElement('img');
      img.src = (element as HTMLImageElement).src;
      img.alt = (element as HTMLImageElement).alt || '';
      lightboxState.contentType = 'image';
      lightboxContainer.appendChild(img);
    } else if (element.classList.contains('mermaid-wrapper')) {
      const svg = element.querySelector('svg');
      if (svg) {
        const clonedSvg = svg.cloneNode(true);
        lightboxState.contentType = 'svg';
        lightboxContainer.appendChild(clonedSvg);
      }
    }

    // Show lightbox
    lightbox.removeAttribute('hidden');
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.classList.add('lightbox-open');
    lightboxState.isOpen = true;

    // Focus close button for accessibility
    setTimeout(() => {
      if (closeBtn) (closeBtn as HTMLElement).focus();
    }, 100);
  }

  function closeLightbox() {
    if (!lightbox) return;

    lightbox.setAttribute('hidden', '');
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('lightbox-open');
    lightboxState.isOpen = false;

    // Clear content and reset state
    setTimeout(() => {
      if (lightboxContainer) lightboxContainer.innerHTML = '';
      resetLightboxState();
    }, 300);
  }

  function zoomIn() {
    lightboxState.currentScale = Math.min(lightboxState.currentScale + lightboxState.scaleStep, lightboxState.maxScale);
    applyTransform();
    if (lightboxState.currentScale > 1 && lightboxViewport) {
      lightboxViewport.classList.add('zoomed');
    }
  }

  function zoomOut() {
    lightboxState.currentScale = Math.max(lightboxState.currentScale - lightboxState.scaleStep, lightboxState.minScale);
    applyTransform();

    // Reset pan when zoomed out to 1x or less
    if (lightboxState.currentScale <= 1) {
      lightboxState.translateX = 0;
      lightboxState.translateY = 0;
      applyTransform();
      if (lightboxViewport) {
        lightboxViewport.classList.remove('zoomed');
      }
    }
  }

  function zoomReset() {
    resetLightboxState();
  }

  // Mouse drag events
  function handleMouseDown(e: MouseEvent) {
    if (lightboxState.currentScale > 1) {
      lightboxState.isDragging = true;
      lightboxState.startX = e.clientX - lightboxState.translateX;
      lightboxState.startY = e.clientY - lightboxState.translateY;
      if (lightboxViewport) {
        lightboxViewport.classList.add('dragging');
      }
    }
  }

  function handleMouseMove(e: MouseEvent) {
    if (lightboxState.isDragging && lightboxState.currentScale > 1) {
      lightboxState.translateX = e.clientX - lightboxState.startX;
      lightboxState.translateY = e.clientY - lightboxState.startY;
      applyTransform();
    }
  }

  function handleMouseUp() {
    lightboxState.isDragging = false;
    if (lightboxViewport) {
      lightboxViewport.classList.remove('dragging');
    }
  }

  // Touch events
  function getTouchDistance(touches: TouchList) {
    const dx = touches[0].clientX - touches[1].clientX;
    const dy = touches[0].clientY - touches[1].clientY;
    return Math.sqrt(dx * dx + dy * dy);
  }

  function handleTouchStart(e: TouchEvent) {
    if (e.touches.length === 2) {
      // Pinch zoom
      lightboxState.lastTouchDistance = getTouchDistance(e.touches);
    } else if (e.touches.length === 1 && lightboxState.currentScale > 1) {
      // Pan
      lightboxState.isDragging = true;
      lightboxState.startX = e.touches[0].clientX - lightboxState.translateX;
      lightboxState.startY = e.touches[0].clientY - lightboxState.translateY;
    }
  }

  function handleTouchMove(e: TouchEvent) {
    if (e.touches.length === 2) {
      // Pinch zoom
      e.preventDefault();
      const currentDistance = getTouchDistance(e.touches);
      const delta = currentDistance - lightboxState.lastTouchDistance;

      if (Math.abs(delta) > 5) {
        lightboxState.currentScale += delta * 0.01;
        lightboxState.currentScale = Math.max(lightboxState.minScale, Math.min(lightboxState.maxScale, lightboxState.currentScale));
        applyTransform();
        lightboxState.lastTouchDistance = currentDistance;

        if (lightboxState.currentScale > 1 && lightboxViewport) {
          lightboxViewport.classList.add('zoomed');
        } else if (lightboxState.currentScale <= 1 && lightboxViewport) {
          lightboxViewport.classList.remove('zoomed');
          lightboxState.translateX = 0;
          lightboxState.translateY = 0;
          applyTransform();
        }
      }
    } else if (e.touches.length === 1 && lightboxState.isDragging && lightboxState.currentScale > 1) {
      // Pan
      lightboxState.translateX = e.touches[0].clientX - lightboxState.startX;
      lightboxState.translateY = e.touches[0].clientY - lightboxState.startY;
      applyTransform();
    }
  }

  function handleTouchEnd(e: TouchEvent) {
    if (e.touches.length < 2) {
      lightboxState.lastTouchDistance = 0;
    }
    if (e.touches.length === 0) {
      lightboxState.isDragging = false;
    }
  }

  // Keyboard events
  function handleKeyboard(e: KeyboardEvent) {
    if (!lightboxState.isOpen) return;

    switch(e.key) {
      case 'Escape':
        closeLightbox();
        break;
      case '+':
      case '=':
        e.preventDefault();
        zoomIn();
        break;
      case '-':
      case '_':
        e.preventDefault();
        zoomOut();
        break;
      case '0':
        e.preventDefault();
        zoomReset();
        break;
    }
  }

  // Initialize lightbox click handlers
  function initLightbox() {
    // Add click handlers to images
    const images = document.querySelectorAll('.content img');
    images.forEach(img => {
      img.addEventListener('click', () => openLightbox(img as HTMLElement));
    });

    // Add click handlers to Mermaid diagrams
    const mermaidWrappers = document.querySelectorAll('.mermaid-wrapper');
    mermaidWrappers.forEach(wrapper => {
      wrapper.addEventListener('click', () => openLightbox(wrapper as HTMLElement));
    });
  }

  // Event listeners for lightbox controls
  if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
  if (backdrop) backdrop.addEventListener('click', closeLightbox);
  if (zoomInBtn) zoomInBtn.addEventListener('click', zoomIn);
  if (zoomOutBtn) zoomOutBtn.addEventListener('click', zoomOut);
  if (zoomResetBtn) zoomResetBtn.addEventListener('click', zoomReset);

  // Mouse events
  if (lightboxViewport) {
    lightboxViewport.addEventListener('mousedown', handleMouseDown as EventListener);
    document.addEventListener('mousemove', handleMouseMove as EventListener);
    document.addEventListener('mouseup', handleMouseUp);
  }

  // Touch events
  if (lightboxViewport) {
    lightboxViewport.addEventListener('touchstart', handleTouchStart as EventListener, { passive: false });
    lightboxViewport.addEventListener('touchmove', handleTouchMove as EventListener, { passive: false });
    lightboxViewport.addEventListener('touchend', handleTouchEnd as EventListener);
  }

  // Keyboard events
  document.addEventListener('keydown', handleKeyboard);

  // Initialize after delay to ensure Mermaid renders first
  setTimeout(() => {
    initLightbox();
  }, 500);

  // Re-initialize on theme changes (handles Mermaid re-renders)
  const lightboxObserver = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (mutation.attributeName === 'class') {
        setTimeout(() => {
          initLightbox();
        }, 300);
      }
    });
  });

  lightboxObserver.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['class']
  });
</script>


