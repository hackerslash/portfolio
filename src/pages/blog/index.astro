---
import Layout from "@/layouts/Layout.astro"
import Blogs from "@/components/sections/Blogs.astro"
import { basics } from "@cv"
import { getBlogs } from "@blogs"

const posts = getBlogs()
const tagCount = new Set(posts.flatMap((p) => p.tags ?? [])).size

const pageTitle = "Writing — Md Afridi Sk"
const pageDescription =
  "Technical writing by Md Afridi Sk on backend engineering, AI systems, observability and the web. Every post, searchable and tagged."

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": `${basics.url}/blog#blog`,
  url: `${basics.url}/blog`,
  name: pageTitle,
  description: pageDescription,
  isPartOf: { "@id": `${basics.url}/#website` },
  author: { "@id": `${basics.url}/#person` },
  blogPost: posts.map((p) => ({
    "@type": "BlogPosting",
    headline: p.title,
    datePublished: p.date,
    description: p.excerpt,
    url: `${basics.url}/blog/${p.id}`,
    keywords: (p.tags ?? []).join(", "),
  })),
}
---

<Layout title={pageTitle} description={pageDescription} jsonLd={jsonLd}>
  <main class="page">
    <header class="index-head">
      <h1>Writing</h1>
      {
        posts.length > 0 && (
          <p class="index-head__count">
            {posts.length} post{posts.length === 1 ? "" : "s"}
            {tagCount > 0 && <> · {tagCount} tags</>}
          </p>
        )
      }
    </header>

    <div class="index-body">
      <Blogs />
    </div>
  </main>
</Layout>

<style>
  .index-head {
    max-width: var(--measure);
    margin-inline: auto;
    padding-block-end: var(--space-lg);
    margin-block-end: var(--space-lg);
    border-block-end: var(--rule-thick) solid var(--color-rule-2);
  }

  h1 {
    font-size: var(--text-display-s);
    font-weight: 700;
    line-height: var(--leading-tight);
    letter-spacing: var(--track-display);
  }

  .index-head__count {
    margin-block-start: var(--space-2xs);
    color: var(--color-ink-3);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  .index-body {
    max-width: var(--measure);
    margin-inline: auto;
  }

  @media (width <= 40rem) {
    .index-head {
      padding-block-end: var(--space-md);
      margin-block-end: var(--space-md);
    }
  }
</style>
