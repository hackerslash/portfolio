---
import { basics } from "@cv"
import Nav from "@/components/Nav.astro"
import SiteFooter from "@/components/SiteFooter.astro"
import "../../tokens.css"

interface Props {
  title: string
  description?: string
  canonicalUrl?: string
  ogImage?: string
  ogType?: string
  keywords?: string
  jsonLd?: object
  /** Preload the portrait. Only the home page renders it. */
  preloadImage?: boolean
}

const { title, description, canonicalUrl, ogImage, ogType, keywords, jsonLd, preloadImage = false } =
  Astro.props

const { image, summary, url, name, location } = basics

const defaultKeywords =
  "Md Afridi Sk, Backend Engineer, Backend Developer, Software Engineer, IIT Kharagpur, Bangalore Developer, Python Developer, TypeScript Developer, Rust Developer, Go Developer, FastAPI, AI Engineer, LLM Agents, RAG, MCP, WebRTC, hackerslash"

const metaDescription = description || summary
const pageCanonicalUrl = canonicalUrl || new URL(Astro.url.pathname, url).href
const pageOgImage = ogImage || `${url}/profile-pic.png`
const pageOgType = ogType || "website"
const metaKeywords = keywords || defaultKeywords
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {preloadImage && <link rel="preload" as="image" href={image} />}
    <link rel="canonical" href={pageCanonicalUrl} />

    <!-- SEO Meta Tags -->
    <meta name="keywords" content={metaKeywords} />
    <meta name="author" content={name} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="googlebot" content="index, follow" />
    <meta name="theme-color" content="#019b59" />

    <!-- Geo Tags for Local SEO -->
    <meta name="geo.region" content="IN-KA" />
    <meta name="geo.placename" content={location.city} />
    <meta name="geo.position" content="12.9716;77.5946" />
    <meta name="ICBM" content="12.9716, 77.5946" />

    <!-- Open Graph -->
    <meta property="og:url" content={pageCanonicalUrl} />
    <meta property="og:type" content={pageOgType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={pageOgImage} />
    <meta property="og:image:width" content="557" />
    <meta property="og:image:height" content="557" />
    <meta property="og:site_name" content="Md Afridi Sk - Portfolio" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content={url.split("//")[1] ?? ""} />
    <meta property="twitter:url" content={pageCanonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={pageOgImage} />
    <meta name="twitter:creator" content="@hackerslash" />

    <!-- JSON-LD Structured Data -->
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <Nav />
    <slot />
    <SiteFooter />

    <script is:inline>
      const root = document.documentElement
      if (localStorage.getItem("theme") === "light") {
        root.classList.add("light")
      }

      // Land at the top on a fresh visit, but never fight a #hash deep link.
      if ("scrollRestoration" in history) {
        history.scrollRestoration = "manual"
      }
      if (!location.hash) {
        window.scrollTo(0, 0)
      }
    </script>
    <script data-goatcounter="https://hackerslash.goatcounter.com/count" async src="//gc.zgo.at/count.js"
    ></script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-body);
    font-size: 100%;
    letter-spacing: var(--track-body);
    background: var(--color-paper);
    color: var(--color-ink-2);
    scrollbar-gutter: stable;
    scroll-behavior: smooth;
    overflow-x: clip;
  }

  body {
    margin: 0;
    padding: 0;
    min-height: 100vh;
    background: var(--color-paper);
    overflow-x: clip;
  }

  h1,
  h2,
  h3,
  h4 {
    margin: 0;
    font-family: var(--font-display);
    font-style: normal;
    color: var(--color-ink);
    overflow-wrap: anywhere;
    min-width: 0;
  }

  p {
    margin: 0;
    color: var(--color-ink-3);
    font-size: var(--text-base);
    line-height: var(--leading-body);
    text-wrap: pretty;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  ul,
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  figure {
    margin: 0;
    padding: 0;
  }

  img,
  svg,
  video {
    max-width: 100%;
  }

  ::selection {
    background: var(--color-accent-mid);
    color: var(--color-ink);
  }

  :focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .page {
    max-width: var(--page);
    margin-inline: auto;
    padding: var(--space-xl) var(--gutter) 0;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }

  ::view-transition-old(root) {
    z-index: var(--z-base);
  }

  ::view-transition-new(root) {
    z-index: var(--z-raised);
    clip-path: circle(0% at var(--reveal-x, 50%) var(--reveal-y, 50%));
    animation: reveal-out 1.2s var(--ease-in-out) forwards;
  }

  @keyframes reveal-out {
    from {
      clip-path: circle(0% at var(--reveal-x, 50%) var(--reveal-y, 50%));
    }
    to {
      clip-path: circle(150% at var(--reveal-x, 50%) var(--reveal-y, 50%));
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .print {
    display: none !important;
  }

  @media print {
    .no-print {
      display: none !important;
    }

    .print {
      display: block !important;
    }

    astro-dev-toolbar {
      display: none !important;
    }

    article {
      break-inside: avoid;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 150ms !important;
      scroll-behavior: auto !important;
    }

    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: none !important;
      clip-path: none !important;
    }
  }
</style>
