---
import Section from "../Section.astro"
import External from "@/icons/External.astro"

import { work } from "@cv"

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]

function label(date: string | null): string {
  if (!date) return "Present"
  const d = new Date(date)
  return `${MONTHS[d.getMonth()]} ${d.getFullYear()}`
}
---

<Section title="Experience" id="experience">
  <ol class="roles">
    {
      work.map(({ name, startDate, endDate, position, summary, url, highlights }) => (
        <li class="role">
          <div class="role__head">
            <h3 class="role__title">
              {position} ·{" "}
              {url ? (
                <a href={url} target="_blank" rel="noopener noreferrer">
                  {name}
                  <External />
                </a>
              ) : (
                <span class="role__org">{name}</span>
              )}
            </h3>
            <p class="role__dates">
              <time datetime={startDate}>{label(startDate)}</time> —{" "}
              <time datetime={endDate ?? undefined}>{label(endDate)}</time>
            </p>
          </div>

          <p class="role__summary">{summary}</p>

          {highlights?.length > 0 && (
            <ul class="role__points">
              {highlights.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .roles {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .role {
    padding-inline-start: var(--space-sm);
    border-inline-start: var(--rule-hair) solid var(--color-rule);
  }

  .role__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-block-end: var(--space-3xs);
  }

  .role__title {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .role__title a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    color: var(--color-ink);
    border-block-end: var(--rule-hair) solid var(--color-rule-2);
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .role__title a :global(svg) {
    width: 13px;
    height: 13px;
  }

  .role__title a:hover {
    color: var(--color-accent-text);
    border-block-end-color: var(--color-accent);
  }

  .role__org {
    color: var(--color-ink);
  }

  .role__dates {
    flex-shrink: 0;
    color: var(--color-ink-3);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .role__summary {
    color: var(--color-ink-2);
    font-size: var(--text-base);
  }

  .role__points {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    margin-block-start: var(--space-2xs);
  }

  .role__points li {
    position: relative;
    padding-inline-start: var(--space-sm);
    color: var(--color-ink-3);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
  }

  .role__points li::before {
    content: "→";
    position: absolute;
    inset-inline-start: 0;
    color: var(--color-accent-text);
  }

  @media (width <= 40rem) {
    .role__head {
      flex-direction: column;
      gap: var(--space-3xs);
    }
  }
</style>
