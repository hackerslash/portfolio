---
import { basics } from "@cv"

const { summary } = basics
---

<div class="lede">
  <p>{summary}</p>
</div>

<style>
  .lede {
    max-width: var(--measure);
    margin-inline: auto;
    margin-block-end: var(--space-2xl);
  }

  .lede p {
    color: var(--color-ink-2);
    font-size: var(--text-md);
    line-height: var(--leading-body);
    text-wrap: pretty;
  }

  @media (width <= 40rem) {
    .lede {
      margin-block-end: var(--space-xl);
    }
  }
</style>
