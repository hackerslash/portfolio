---
import { getBlogs } from "@blogs"
import { formatDate } from "@/utils/formatDate"
import Tag from "@/components/Tag.astro"
import { BLOG_POSTS_PER_PAGE_INDEX } from "@/utils/constants"

const blogs = getBlogs()
const perPage = BLOG_POSTS_PER_PAGE_INDEX
const paginated = blogs.length > perPage
const totalPages = Math.ceil(blogs.length / perPage)
---

{
  blogs.length === 0 ? (
    <p class="empty">Nothing published yet.</p>
  ) : (
    <div class="index">
      <div class="search">
        <label class="sr-only" for="blog-search">
          Search posts
        </label>
        <input
          type="search"
          id="blog-search"
          class="search__input"
          placeholder="search posts…"
          autocomplete="off"
        />
        <p class="search__count" id="search-results" aria-live="polite" />
      </div>

      <ol class="posts dim-list" data-per-page={perPage}>
        {blogs.map(({ id, title, date, excerpt, tags, readingTime }, index) => (
          <li
            data-post-index={index}
            data-search={[title, excerpt, ...(tags ?? [])].join(" ").toLowerCase()}
            data-reveal-delay={Math.min(index, 3) * 60}
            class={`dim-row reveal-hidden${paginated && index >= perPage ? " is-hidden" : ""}`}
          >
            <article class="post">
              <p class="post__meta mono-label">
                <time datetime={date}>{formatDate(date)}</time> · {readingTime}
              </p>
              <h3 class="post__title">
                <a href={`/blog/${id}`}>{title}</a>
              </h3>
              <p class="post__excerpt">{excerpt}</p>
              {tags && tags.length > 0 && (
                <div class="post__tags">
                  {tags.map((tag: string) => (
                    <Tag tag={tag} />
                  ))}
                </div>
              )}
            </article>
          </li>
        ))}
      </ol>

      {paginated && (
        <nav class="pager" aria-label="Pagination">
          <button class="pager__btn" id="prev-btn" type="button" disabled>
            ← Newer
          </button>
          <span class="pager__info">
            <span id="current-page">1</span> / <span>{totalPages}</span>
          </span>
          <button class="pager__btn" id="next-btn" type="button">
            Older →
          </button>
        </nav>
      )}
    </div>
  )
}

<style>
  .empty {
    padding-block: var(--space-lg);
    color: var(--color-ink-3);
  }

  .search {
    margin-block-end: var(--space-lg);
  }

  .search__input {
    width: 100%;
    padding: var(--space-2xs) var(--space-xs);
    background: var(--color-paper-2);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-sm);
    color: var(--color-ink-2);
    font-family: var(--font-body);
    font-size: var(--text-base);
    letter-spacing: var(--track-body);
    min-height: 44px;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .search__input::placeholder {
    color: var(--color-ink-4);
  }

  .search__input:hover {
    border-color: var(--color-rule-2);
  }

  .search__input:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 1px;
    border-color: var(--color-accent);
  }

  .search__count {
    margin-block-start: var(--space-3xs);
    min-height: 1.2em;
    color: var(--color-ink-3);
    font-size: var(--text-xs);
  }

  .posts li.is-hidden {
    display: none;
  }

  /* Only a row with a *visible* predecessor gets a rule — otherwise page 2 and
     filtered results open with a stray hairline. */
  .posts li:not(.is-hidden) ~ li:not(.is-hidden) {
    border-block-start: var(--rule-hair) solid var(--color-rule);
  }

  .post {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding-block: var(--space-md);
  }

  .post__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: var(--leading-snug);
  }

  .post__title a {
    border-block-end: var(--rule-hair) solid transparent;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .post__title a:hover {
    color: var(--color-accent-text);
    border-block-end-color: var(--color-accent);
  }

  .post__meta {
    font-variant-numeric: tabular-nums;
  }

  .post__excerpt {
    max-width: var(--measure);
    color: var(--color-ink-3);
    font-size: var(--text-base);
  }

  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin-block-start: var(--space-2xs);
  }

  .pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-block-start: var(--space-lg);
    padding-block-start: var(--space-md);
    border-block-start: var(--rule-hair) solid var(--color-rule);
  }

  .pager__btn {
    min-height: 44px;
    padding-inline: var(--space-xs);
    background: none;
    border: var(--rule-hair) solid var(--color-rule-2);
    border-radius: var(--radius-sm);
    color: var(--color-ink-3);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    letter-spacing: var(--track-body);
    white-space: nowrap;
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .pager__btn:hover:not(:disabled) {
    color: var(--color-accent-text);
    border-color: var(--color-accent);
  }

  .pager__btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .pager__btn:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .pager__info {
    color: var(--color-ink-3);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  const list = document.querySelector<HTMLElement>(".posts")
  if (list) {
    const perPage = Number(list.dataset.perPage) || 10
    const items = Array.from(list.querySelectorAll<HTMLElement>("[data-post-index]"))
    const totalPages = Math.ceil(items.length / perPage)

    const prevBtn = document.getElementById("prev-btn") as HTMLButtonElement | null
    const nextBtn = document.getElementById("next-btn") as HTMLButtonElement | null
    const pageLabel = document.getElementById("current-page")
    const searchInput = document.getElementById("blog-search") as HTMLInputElement | null
    const searchCount = document.getElementById("search-results")
    const pager = document.querySelector<HTMLElement>(".pager")

    let page = 1

    function showPage(next: number) {
      page = Math.min(Math.max(next, 1), totalPages)
      const start = (page - 1) * perPage
      items.forEach((item, i) => {
        item.classList.toggle("is-hidden", i < start || i >= start + perPage)
      })
      if (pageLabel) pageLabel.textContent = String(page)
      if (prevBtn) prevBtn.disabled = page === 1
      if (nextBtn) nextBtn.disabled = page === totalPages
    }

    prevBtn?.addEventListener("click", () => showPage(page - 1))
    nextBtn?.addEventListener("click", () => showPage(page + 1))

    searchInput?.addEventListener("input", (event) => {
      const query = (event.target as HTMLInputElement).value.toLowerCase().trim()

      if (!query) {
        if (searchCount) searchCount.textContent = ""
        if (pager) pager.hidden = false
        showPage(page)
        return
      }

      let matches = 0
      items.forEach((item) => {
        const hit = (item.dataset.search ?? "").includes(query)
        item.classList.toggle("is-hidden", !hit)
        if (hit) matches++
      })

      if (searchCount) {
        searchCount.textContent = matches === 0 ? "no posts found" : `${matches} post${matches === 1 ? "" : "s"}`
      }
      if (pager) pager.hidden = true
    })
  }
</script>
