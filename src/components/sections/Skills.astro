---
import Section from "../Section.astro"
import { skills } from "@cv"

// Grouped by `category`, falling back to `level` for older cv.json shapes.
// Group order follows first appearance, so the JSON controls reading order.
const groups: { key: string; items: string[] }[] = []

for (const skill of skills as Array<{ name: string; category?: string; level?: string }>) {
  const key = skill.category ?? skill.level ?? "Other"
  const group = groups.find((g) => g.key === key)
  if (group) group.items.push(skill.name)
  else groups.push({ key, items: [skill.name] })
}
---

<Section title="Skills" id="skills">
  <dl class="skills">
    {
      groups.map(({ key, items }) => (
        <div class="skills__group">
          <dt>{key.toLowerCase()}</dt>
          <dd>
            <ul>
              {items.map((name) => (
                <li>{name}</li>
              ))}
            </ul>
          </dd>
        </div>
      ))
    }
  </dl>
</Section>

<style>
  .skills {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .skills__group {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--space-sm);
    align-items: start;
  }

  .skills__group + .skills__group {
    padding-block-start: var(--space-md);
    border-block-start: var(--rule-hair) solid var(--color-rule);
  }

  dt {
    color: var(--color-ink-4);
    font-size: var(--text-xs);
    padding-block-start: 3px;
  }

  dt::after {
    content: " ›";
    color: var(--color-accent-text);
  }

  dd {
    margin: 0;
    min-width: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
  }

  li {
    padding: 1px var(--space-2xs);
    background: var(--color-paper-2);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-sm);
    color: var(--color-ink-2);
    font-size: var(--text-xs);
    letter-spacing: 0;
  }

  @media (width <= 40rem) {
    .skills__group {
      grid-template-columns: 1fr;
      gap: var(--space-2xs);
    }
  }
</style>
