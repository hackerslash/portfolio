---
interface Props {
  title?: string
  id?: string
  wide?: boolean
  action?: string
  actionHref?: string
}

const { title, id, wide = false, action, actionHref } = Astro.props
---

<section id={id} class:list={["section", { "section--wide": wide }]}>
  {
    title && (
      <div class="section__head">
        <h2>{title}</h2>
        <span class="section__rule" aria-hidden="true" />
        {action && actionHref && (
          <a class="section__action" href={actionHref}>
            {action} <span aria-hidden="true">→</span>
          </a>
        )}
      </div>
    )
  }
  <slot />
</section>

<style>
  .section {
    width: 100%;
    max-width: var(--measure);
    margin-inline: auto;
    margin-block-end: var(--space-2xl);
  }

  .section--wide {
    max-width: var(--page);
  }

  .section__head {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-block-end: var(--space-md);
  }

  h2 {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    font-style: normal;
    letter-spacing: -0.02em;
    line-height: var(--leading-snug);
    color: var(--color-ink);
  }

  .section__rule {
    flex: 1;
    height: var(--rule-hair);
    min-width: var(--space-sm);
    background: var(--color-rule);
  }

  .section__action {
    flex-shrink: 0;
    color: var(--color-ink-3);
    font-size: var(--text-sm);
    white-space: nowrap;
    border-block-end: var(--rule-hair) solid var(--color-rule-2);
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .section__action:hover {
    color: var(--color-accent-text);
    border-block-end-color: var(--color-accent);
  }

  .section__action:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
    border-radius: 2px;
  }

  @media (width <= 40rem) {
    .section {
      margin-block-end: var(--space-xl);
    }

    .section__head {
      flex-wrap: wrap;
      gap: var(--space-2xs) var(--space-sm);
    }

    .section__rule {
      order: 3;
      flex-basis: 100%;
    }
  }
</style>
