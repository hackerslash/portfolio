---
const path = Astro.url.pathname.replace(/\/+$/, "") || "/"

const flags = [
  { href: "/work", label: "work" },
  { href: "/about", label: "about" },
  { href: "/blog", label: "writing" },
]

const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`)
---

<nav class="nav no-print" aria-label="Primary">
  <span class="nav__lead">
    <a class="nav__prompt" href="/" aria-current={path === "/" ? "page" : undefined}>
      <span class="nav__user">mdafridisk@hackerslash</span><span class="nav__sigil">:~$</span>
    </a>
    <span class="nav__cursor" aria-hidden="true">▮</span>
  </span>

  <ul class="nav__flags">
    {
      flags.map(({ href, label }) => (
        <li>
          <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>
            <span class="nav__dashes" aria-hidden="true">
              --
            </span>
            {label}
          </a>
        </li>
      ))
    }
  </ul>

  <button id="theme-toggle" class="nav__toggle" type="button" aria-label="Toggle dark and light theme">
    <svg
      class="nav__sun"
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      ><circle cx="12" cy="12" r="4"></circle><path
        d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
      ></path></svg
    >
    <svg
      class="nav__moon"
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg
    >
  </button>
</nav>

<script>
  import { toggleTheme } from "@/utils/theme"

  const toggle = document.getElementById("theme-toggle")

  toggle?.addEventListener("click", () => {
    const rect = toggle.getBoundingClientRect()
    toggleTheme(rect.left + rect.width / 2, rect.top + rect.height / 2)
  })
</script>

<style>
  .nav {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-sticky);
    display: grid;
    grid-template-areas:
      "prompt toggle"
      "flags  flags";
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-2xs) var(--space-sm);
    padding: var(--space-2xs) var(--gutter);
    max-width: var(--page);
    margin-inline: auto;
    background: var(--color-paper);
    border-block-end: var(--rule-hair) solid var(--color-rule);
    font-size: var(--text-sm);
  }

  .nav__lead {
    grid-area: prompt;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    min-width: 0;
  }

  .nav__prompt {
    color: var(--color-ink-3);
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .nav__prompt:hover,
  .nav__prompt[aria-current="page"] {
    color: var(--color-ink-2);
  }

  .nav__sigil {
    color: var(--color-accent-text);
  }

  .nav__flags {
    grid-area: flags;
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    min-width: 0;
  }

  .nav__flags a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-3xs);
    color: var(--color-ink-3);
    white-space: nowrap;
    border-block-end: var(--rule-thick) solid transparent;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .nav__dashes {
    color: var(--color-ink-4);
    margin-inline-end: 1px;
  }

  .nav__flags a:hover {
    color: var(--color-ink);
  }

  .nav__flags a:hover .nav__dashes {
    color: var(--color-accent-text);
  }

  .nav__flags a[aria-current="page"] {
    color: var(--color-accent-text);
    border-block-end-color: var(--color-accent);
  }

  .nav__flags a[aria-current="page"] .nav__dashes {
    color: var(--color-accent-text);
  }

  .nav__flags a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: -2px;
    border-radius: var(--radius-sm);
  }

  .nav__prompt:focus-visible,
  .nav__toggle:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .nav__cursor {
    color: var(--color-accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  .nav__toggle {
    grid-area: toggle;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    background: none;
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-sm);
    color: var(--color-ink-3);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .nav__toggle:hover {
    color: var(--color-accent-text);
    border-color: var(--color-accent-mid);
  }

  .nav__moon {
    display: none;
  }

  :global(.light) .nav__moon {
    display: block;
  }

  :global(.light) .nav__sun {
    display: none;
  }

  @media (width >= 40rem) {
    .nav {
      grid-template-areas: "prompt flags toggle";
      grid-template-columns: auto 1fr auto;
      padding-block: var(--space-3xs);
    }

    .nav__flags {
      gap: var(--space-xs);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__cursor {
      animation: none;
    }
  }
</style>
