---
import GitHub from "@/icons/GitHub.astro"
import External from "@/icons/External.astro"
import ProjectCover from "@/components/ProjectCover.astro"
import type { Project } from "@/utils/projects"

interface Props {
  project: Project
  variant?: "feature" | "index"
  showYear?: boolean
  eager?: boolean
}

const { project, variant = "feature", showYear = false, eager = false } = Astro.props
const { name, slug, tagline, description, image, imageAlt, year, isActive, stack, url, github, href, hrefKind } =
  project

const copy = variant === "index" ? description : tagline
const chipLabel = hrefKind === "github" ? "source ↗" : "live ↗"
const openLabel = hrefKind === "github" ? "source on GitHub" : "live site"
const stackShown = variant === "index" ? stack : stack.slice(0, 4)
---

<article class="tile">
  <div class="tile__cover">
    <ProjectCover slug={slug} name={name} image={image} imageAlt={imageAlt} eager={eager} />
    {isActive && <span class="tile__status">live</span>}
    {href && (
      <span class="tile__chip" aria-hidden="true">
        {chipLabel}
      </span>
    )}
  </div>

  <div class="tile__body">
    <div class="tile__heading">
      <h3 class="tile__name">
        {
          href ? (
            <a class="tile__stretch" href={href} target="_blank" rel="noopener noreferrer">
              {name}
              <span class="sr-only"> — open {openLabel}</span>
            </a>
          ) : (
            name
          )
        }
      </h3>
      {showYear && year && <span class="tile__year">{year}</span>}
    </div>

    <p class="tile__copy">{copy}</p>

    {
      stackShown.length > 0 && (
        <ul class="tile__stack">
          {stackShown.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }

    <div class="tile__links">
      {
        github && (
          <a
            class="tile__icon"
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${name} — source on GitHub`}
          >
            <GitHub />
          </a>
        )
      }
      {
        url && (
          <a
            class="tile__icon"
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${name} — live site`}
          >
            <External />
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-paper-2);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-card);
    overflow: hidden;
    transition:
      border-color var(--dur-short) var(--ease-out),
      background-color var(--dur-short) var(--ease-out),
      transform var(--dur-short) var(--ease-out);
  }

  .tile:hover,
  .tile:focus-within {
    background: var(--color-paper-3);
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }

  .tile__cover {
    position: relative;
    overflow: hidden;
  }

  .tile__cover :global(.cover) {
    transition: scale var(--dur-med) var(--ease-out);
  }

  .tile:hover .tile__cover :global(.cover),
  .tile:focus-within .tile__cover :global(.cover) {
    scale: 1.03;
  }

  .tile__status {
    position: absolute;
    inset-block-start: var(--space-2xs);
    inset-inline-end: var(--space-2xs);
    z-index: var(--z-raised);
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    padding: 2px var(--space-2xs);
    border-radius: var(--radius-pill);
    background: var(--color-paper);
    border: var(--rule-hair) solid var(--color-accent-mid);
    color: var(--color-accent-text);
    font-size: var(--text-xs);
    letter-spacing: 0;
  }

  .tile__status::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent);
    animation: livePulse 2.4s var(--ease-in-out) infinite;
  }

  @keyframes livePulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  .tile__chip {
    position: absolute;
    inset-block-end: var(--space-2xs);
    inset-inline-end: var(--space-2xs);
    z-index: var(--z-raised);
    padding: var(--space-3xs) var(--space-2xs);
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0;
    opacity: 0;
    translate: 0 4px;
    transition:
      opacity var(--dur-short) var(--ease-out),
      translate var(--dur-short) var(--ease-out);
  }

  .tile:hover .tile__chip,
  .tile:focus-within .tile__chip {
    opacity: 1;
    translate: 0 0;
  }

  .tile__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-sm);
  }

  .tile__heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs);
  }

  .tile__name {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .tile__stretch {
    color: inherit;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .tile__stretch::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: var(--z-base);
  }

  .tile:hover .tile__stretch,
  .tile__stretch:focus-visible {
    color: var(--color-accent-text);
  }

  .tile__stretch:focus-visible {
    outline: none;
  }

  .tile__stretch:focus-visible::after {
    outline: 2px solid var(--color-focus);
    outline-offset: -3px;
    border-radius: var(--radius-card);
  }

  .tile__year {
    flex-shrink: 0;
    color: var(--color-ink-3);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .tile__copy {
    flex: 1;
    color: var(--color-ink-3);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .tile__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin-block-start: var(--space-3xs);
  }

  .tile__stack li {
    padding: 1px var(--space-2xs);
    border: var(--rule-hair) solid var(--color-rule-2);
    border-radius: var(--radius-sm);
    color: var(--color-ink-3);
    font-size: var(--text-xs);
    letter-spacing: 0;
  }

  .tile__links {
    display: flex;
    gap: var(--space-3xs);
    margin-block-start: var(--space-2xs);
    margin-inline-start: calc(var(--space-2xs) * -1);
  }

  .tile__icon {
    position: relative;
    z-index: var(--z-raised);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    border-radius: var(--radius-sm);
    color: var(--color-ink-3);
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .tile__icon:hover {
    color: var(--color-accent-text);
    background: var(--color-accent-dim);
  }

  .tile__icon:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
    color: var(--color-accent-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .tile,
    .tile__cover :global(.cover),
    .tile__chip {
      transition-duration: 150ms;
      transition-property: opacity, color, border-color, background-color;
    }

    .tile:hover,
    .tile:focus-within {
      transform: none;
    }

    .tile:hover .tile__cover :global(.cover),
    .tile:focus-within .tile__cover :global(.cover) {
      scale: 1;
    }

    .tile__chip {
      translate: 0 0;
    }

    .tile__status::before {
      animation: none;
    }
  }

  @media print {
    .tile__status::before {
      animation: none;
    }
  }
</style>
