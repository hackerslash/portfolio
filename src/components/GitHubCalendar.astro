---
import { basics } from "@cv"

const username = basics.profiles.find((p) => p.network === "GitHub")?.username
---

<div class="cal" data-user={username} hidden>
  <div class="cal__scroll">
    <div class="cal__track">
      <div class="cal__months"></div>
      <div class="cal__grid" role="group"></div>
    </div>
  </div>
  <div class="cal__foot">
    <span class="cal__total"></span>
    <span class="cal__legend">
      Less
      <span class="cal__cell" data-level="0"></span>
      <span class="cal__cell" data-level="1"></span>
      <span class="cal__cell" data-level="2"></span>
      <span class="cal__cell" data-level="3"></span>
      <span class="cal__cell" data-level="4"></span>
      More
    </span>
  </div>
  <div class="cal__tip" role="tooltip" hidden></div>
</div>

<script>
  type Day = { date: string; count: number; level: number }
  type Cache = { at: number; days: Day[]; total: number }

  const TTL = 2 * 60 * 60 * 1000
  const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]

  const utc = (d: string) => new Date(d + "T00:00:00Z")
  const fmt = (d: string) =>
    utc(d).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" })

  async function load(user: string): Promise<Cache | null> {
    const key = `gh-contrib:${user}`
    let stale: Cache | null = null
    try {
      const raw = localStorage.getItem(key)
      if (raw) {
        stale = JSON.parse(raw)
        if (stale && Date.now() - stale.at < TTL) return stale // fresh cache hit
      }
    } catch {
      // localStorage blocked (private mode etc.) — fall through to network
    }
    try {
      const res = await fetch(`https://github-contributions-api.jogruber.de/v4/${user}?y=last`)
      if (!res.ok) return stale
      const data = await res.json()
      const payload: Cache = { at: Date.now(), days: data.contributions ?? [], total: data.total?.lastYear ?? 0 }
      try {
        localStorage.setItem(key, JSON.stringify(payload))
      } catch {
        // storage full / blocked — cache write is best-effort
      }
      return payload
    } catch {
      return stale // offline / rate-limited — serve stale cache if we have it
    }
  }

  function render(cal: HTMLElement, { days, total }: Cache) {
    if (!days.length) return

    const pad = utc(days[0].date).getUTCDay()
    const cols = Math.ceil((pad + days.length) / 7)

    const months: string[] = []
    let lastMonth = utc(days[0].date).getUTCMonth()
    let lastLabelCol = -3
    days.forEach((d, i) => {
      const col = Math.floor((pad + i) / 7)
      const m = utc(d.date).getUTCMonth()
      if (m !== lastMonth) {
        lastMonth = m
        if (col - lastLabelCol >= 3) {
          months.push(`<span class="cal__month" style="grid-column:${col + 1}">${MONTHS[m]}</span>`)
          lastLabelCol = col
        }
      }
    })

    const cells =
      Array.from({ length: pad }, () => `<span class="cal__cell cal__cell--pad" aria-hidden="true"></span>`).join("") +
      days
        .map((d) => {
          const label = `${d.count} contribution${d.count === 1 ? "" : "s"} on ${fmt(d.date)}`
          return `<span class="cal__cell" data-level="${d.level}" role="img" tabindex="0" aria-label="${label}"></span>`
        })
        .join("")

    const track = cal.querySelector<HTMLElement>(".cal__track")!
    track.style.setProperty("--cols", String(cols))
    cal.querySelector<HTMLElement>(".cal__months")!.innerHTML = months.join("")

    const grid = cal.querySelector<HTMLElement>(".cal__grid")!
    grid.setAttribute("aria-label", `${total} GitHub contributions in the last year`)
    grid.innerHTML = cells

    cal.querySelector<HTMLElement>(".cal__total")!.textContent = `${total} contributions in the last year`
    cal.hidden = false

    const tip = cal.querySelector<HTMLElement>(".cal__tip")!
    const show = (cell: HTMLElement) => {
      tip.textContent = cell.getAttribute("aria-label") ?? ""
      tip.hidden = false
      const c = cell.getBoundingClientRect()
      const r = cal.getBoundingClientRect()
      tip.style.left = `${c.left - r.left + c.width / 2}px`
      tip.style.top = `${c.top - r.top}px`
    }
    const hide = () => (tip.hidden = true)
    const from = (e: Event) => (e.target as HTMLElement).closest<HTMLElement>('.cal__cell[role="img"]')

    grid.addEventListener("pointerover", (e) => {
      const cell = from(e)
      if (cell) show(cell)
    })
    grid.addEventListener("pointerleave", hide)
    grid.addEventListener("focusin", (e) => {
      const cell = from(e)
      if (cell) show(cell)
    })
    grid.addEventListener("focusout", hide)
  }

  document.querySelectorAll<HTMLElement>(".cal[data-user]").forEach(async (cal) => {
    const user = cal.dataset.user
    if (!user) return
    const data = await load(user)
    if (data) render(cal, data)
  })
</script>

<style is:global>
  /* Global (not scoped): the grid cells and month labels are injected by the
     client script, so they never receive Astro's scoped-style attribute.
     Every selector below is namespaced under .cal to stay isolated. */
  .cal {
    position: relative;
  }

  .cal__scroll {
    overflow-x: auto;
    padding-block-end: var(--space-3xs);
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .cal__scroll::-webkit-scrollbar {
    display: none;
  }

  .cal__tip {
    position: absolute;
    z-index: 2;
    transform: translate(-50%, calc(-100% - 6px));
    padding: var(--space-3xs) var(--space-2xs);
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: var(--text-xs);
    white-space: nowrap;
    border-radius: var(--radius-sm);
    pointer-events: none;
  }

  .cal__cell[role="img"]:hover {
    outline: var(--rule-hair) solid var(--color-ink-3);
    outline-offset: 0;
  }

  .cal__cell[role="img"]:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 1px;
  }

  .cal__track {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    min-width: 46rem;
  }

  .cal__months {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: 3px;
    color: var(--color-ink-3);
    font-size: var(--text-xs);
    line-height: 1;
  }

  .cal__month {
    grid-row: 1;
    white-space: nowrap;
  }

  .cal__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    grid-template-rows: repeat(7, 1fr);
    grid-auto-flow: column;
    gap: 3px;
  }

  .cal__cell {
    aspect-ratio: 1;
    border-radius: 2px;
    background: var(--color-paper-3);
    outline: var(--rule-hair) solid var(--color-rule);
    outline-offset: -1px;
  }

  .cal__cell--pad {
    background: transparent;
    outline: none;
  }

  .cal__cell[data-level="1"] { background: color-mix(in oklch, var(--color-accent), transparent 62%); outline-color: transparent; }
  .cal__cell[data-level="2"] { background: color-mix(in oklch, var(--color-accent), transparent 40%); outline-color: transparent; }
  .cal__cell[data-level="3"] { background: color-mix(in oklch, var(--color-accent), transparent 18%); outline-color: transparent; }
  .cal__cell[data-level="4"] { background: var(--color-accent); outline-color: transparent; }

  /* Light beige washes out translucent greens — give light mode an opaque,
     stepped ramp (light→dark) so the low levels read clearly. */
  :root.light .cal__cell[data-level="1"] { background: oklch(78% 0.135 163); }
  :root.light .cal__cell[data-level="2"] { background: oklch(67% 0.155 163); }
  :root.light .cal__cell[data-level="3"] { background: oklch(56% 0.15 163); }
  :root.light .cal__cell[data-level="4"] { background: oklch(45% 0.115 163); }

  .cal__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-2xs);
    color: var(--color-ink-3);
    font-size: var(--text-xs);
  }

  .cal__legend {
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }

  .cal__legend .cal__cell {
    width: 11px;
    height: 11px;
    aspect-ratio: auto;
  }
</style>
